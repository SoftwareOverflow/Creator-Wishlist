@page "/user/wishlists/{Id:guid}"
@layout UserLayout


<h3>WishlistDetails</h3>

@if(_wishlist == null)
{
    <p>Loading...</p>
}
else
{
    <h5>
        Wishlist: @_wishlist.Title
    </h5>
    <h6>
        <i>@_wishlist.Description</i>
    </h6>

    @if (!_wishlist.Items.Any())
    {
        <div>
            <p>It looks you have no items yet... Let's add some!</p>
        </div>
    }

    @foreach (var wishlistItem in _wishlist.Items)
    {
        <div class="m2 mx-3 bg-light">
            <h6>@wishlistItem.Name</h6>
            <p>@wishlistItem.Description</p>
        </div>
    }
}